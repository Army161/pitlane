{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noEmit": true, "jsx": "preserve", "types": ["node", "vitest/globals"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "apps/web/.next"]
}
